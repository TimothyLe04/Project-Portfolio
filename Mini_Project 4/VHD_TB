
library ieee;
use ieee.std_logic_1164.all;
use ieee.numeric_std.all;
use work.wave_package.all;

entity wavegen_tb is
end entity wavegen_tb;

architecture bench of wavegen_tb is

    component wavegen is
        port (
            clock   : in  std_logic;
            reset   : in  std_logic;
            enable  : in  std_logic;
            wave_out: out std_logic_vector(data_bits - 1 downto 0);
            JA      : out std_logic_vector(data_bits - 1 downto 0)
        );
    end component;

    signal clock    : std_logic := '0';
    signal reset    : std_logic := '1';
    signal enable   : std_logic := '0';

    signal wave_out : std_logic_vector(data_bits - 1 downto 0);
    signal JA       : std_logic_vector(data_bits - 1 downto 0);

    constant clock_period : time := 100 ns;

begin

    uut : wavegen
        port map (
            clock    => clock,
            reset    => reset,
            enable   => enable,
            wave_out => wave_out,
            JA       => JA
        );

    -- Continuous clock
    clocking : process
    begin
        while true loop
            clock <= '0';
            wait for clock_period / 2;

            clock <= '1';
            wait for clock_period / 2;
        end loop;
    end process;

    -- Reset and enable stimulus
    stimulus : process
    begin
        reset  <= '1';
        enable <= '0';

        wait for 200 ns;

        reset  <= '0';
        enable <= '1';

        wait for 10 ms;

        wait;
    end process;

end architecture bench;
