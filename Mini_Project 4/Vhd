
library ieee;
use ieee.std_logic_1164.all;
use ieee.numeric_std.all;
use work.wave_package.all;

entity wavegen is
    port (
        clock    : in  std_logic;
        reset    : in  std_logic;
        enable   : in  std_logic;
        wave_out : out std_logic_vector(data_bits - 1 downto 0);
        JA       : out std_logic_vector(data_bits - 1 downto 0)
    );
end entity wavegen;

architecture arch1 of wavegen is

    signal addr : integer range 0 to max_address := 0;

    signal sine_table : ROM_type := sine_rom;

    signal sine_vector :
        std_logic_vector(data_bits - 1 downto 0) := (others => '0');

begin

    process(clock)
    begin
        if rising_edge(clock) then
            if reset = '1' then
                sine_vector <= (others => '0');
                addr <= 0;

            elsif enable = '1' then
                sine_vector <= std_logic_vector(sine_table(addr));

                if addr = max_address then
                    addr <= 0;
                else
                    addr <= addr + 1;
                end if;
            end if;
        end if;
    end process;

    JA <= sine_vector;
    wave_out <= sine_vector;

end architecture arch1;
